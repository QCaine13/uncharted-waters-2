{
  "name": "uncharter-waters-2",
  "version": "0.1.0",
  "description": "Browser-based remake of Uncharted Waters: New Horizons (大航海時代II)",
  "scripts": {
    "start": "webpack serve --mode development",
    "cypress": "cypress open",
    "cypress:run": "cypress run --browser chrome",
    "lint": "eslint src/ --ext .ts --ext .tsx",
    "prettier": "prettier --write src/ tests/ scripts/",
    "prettier:check": "prettier --check src/ tests/ scripts/",
    "prepare": "husky",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify:assets": "node scripts/verify-assets.js",
    "story:validate": "node scripts/story-content.js validate",
    "story:report": "STORY_REPORT=1 node scripts/story-content.js report",
    "build:webpack": "rm -rf build/ && webpack --mode production",
    "build": "npm run verify:assets && npm run build:webpack",
    "serve:build": "http-server build --silent",
    "test:e2e:built": "start-server-and-test serve:build http://127.0.0.1:8080 cypress:run",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "verify": "npm run verify:assets && npm run story:validate && npm run prettier:check && npm test -- --runInBand && npm run typecheck && npm run lint && npm run build:webpack",
    "verify:full": "npm run verify && npm run test:e2e:built"
  },
  "author": "Johan Li",
  "license": "MIT",
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-typescript",
      [
        "@babel/preset-env",
        {
          "targets": "defaults"
        }
      ]
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.19.4",
    "@headlessui/react": "^1.7.3",
    "@heroicons/react": "^2.0.12",
    "lodash.throttle": "^4.1.1",
    "pixi.js": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/plugin-transform-runtime": "^7.19.1",
    "@babel/preset-env": "^7.19.4",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/lodash.throttle": "^4.1.7",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.12",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cypress": "^16.3.0",
    "eslint": "^8.25.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-mock": "^30.5.2",
    "lint-staged": "^17.5.1",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss": "^8.4.18",
    "postcss-loader": "^8.2.1",
    "prettier": "3.10.1",
    "react-refresh": "^0.19.0",
    "start-server-and-test": "^3.0.13",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.1.8",
    "typescript": "^5.9.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
